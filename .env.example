# ─── Server ────────────────────────────────────────────────
PORT=3000
# Public HTTPS URL Twilio can reach (use ngrok in development: ngrok http 3000)
PUBLIC_URL=https://your-subdomain.ngrok-free.app
# Secret for admin endpoints (change this!)
ADMIN_TOKEN=change-me

# ─── Voice calls (Twilio) ──────────────────────────────────
# Leave empty to run in DEMO mode (no real calls; use the keypad simulator in the dashboard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=+1xxxxxxxxxx
# Verify that webhooks really come from Twilio (recommended in production)
TWILIO_VALIDATE_WEBHOOKS=true

# ─── WhatsApp alerts ───────────────────────────────────────
# Provider: twilio | meta | console
WHATSAPP_PROVIDER=console
# Twilio WhatsApp sender (sandbox number shown here)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Meta WhatsApp Cloud API (if WHATSAPP_PROVIDER=meta)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Alerts arrive outside WhatsApp's 24-hour window, so they need an approved template
# (two variables: {{1}} title, {{2}} details). Without one, alerts look sent but never arrive.
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=en
TWILIO_WHATSAPP_CONTENT_SID=
# Delivery receipts from Meta: callback https://<PUBLIC_URL>/whatsapp/meta
META_WA_VERIFY_TOKEN=
META_APP_SECRET=

# ─── Behaviour ─────────────────────────────────────────────
# Minutes to wait before retrying an unanswered call
RETRY_AFTER_MINUTES=15
# How many unanswered attempts before alerting the family
MAX_ATTEMPTS=2
# Sugar reading thresholds (mg/dL) that trigger an alert
SUGAR_LOW=70
SUGAR_HIGH=250

# ─── Payments ──────────────────────────────────────────────
# Razorpay / Stripe payment links shown after sign-up
PAYMENT_LINK_INR=
PAYMENT_LINK_USD=

# ─── Family voices (optional) ──────────────────────────────
# Families can always record lines in their own voice from the dashboard.
# With an ElevenLabs key, we also learn that voice from the recordings and use it for
# lines they haven't recorded: new medicines and typed messages. Leave empty to skip.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Where recorded clips are stored (default: data/audio)
# AUDIO_DIR=
