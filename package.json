{
  "name": "amma-checkin",
  "version": "0.1.0",
  "description": "A warm daily phone call to elderly parents, in their own language, with instant WhatsApp alerts to their children.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
