    "seed": "node scripts/seed.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": ["elder-care", "ivr", "twilio", "whatsapp", "india"],
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.21.2"
  }
}
